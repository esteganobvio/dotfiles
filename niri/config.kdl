// Niri configuration (KDL format: https://kdl.dev)
// Wiki: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

//--------------------------------------------------------------------------------
// Input
//--------------------------------------------------------------------------------
input {
    keyboard {
        track-layout "global"
        xkb {}
        numlock
    }

    touchpad {
        tap
        dwt
        dwtp
        natural-scroll
        scroll-method "two-finger"
        click-method "clickfinger"
    }

    // Focus windows and outputs automatically when moving the mouse into them.
    // max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="0%"
}

//--------------------------------------------------------------------------------
// Outputs
// Names come from `niri msg outputs`.
//--------------------------------------------------------------------------------
output "Virtual-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
}

output "AU Optronics 0xD291 Unknown" {
    mode "1920x1200@60.026"
    variable-refresh-rate
    scale 1
    transform "normal"
    position x=1920 y=0
}

output "Samsung Electric Company LF24T35 H9VT204063" {
    mode "1920x1080@74.973"
    focus-at-startup
    variable-refresh-rate
    scale 1
    transform "normal"
    position x=0 y=0
}

output "Goldstar Company Ltd 23MP55" {
    mode "1920x1080@60.000"
    variable-refresh-rate
    scale 1
    transform "normal"
    position x=1920 y=0
}

output "Sharp Corporation 0x148D Unknown" {
    mode "3840x2160@59.997"
    scale 2
    transform "normal"
}

output "LG Electronics 23MP55 0x00004008" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=1920 y=0
}

//--------------------------------------------------------------------------------
// Workspaces
//--------------------------------------------------------------------------------
workspace "terminal" {
    open-on-output "Samsung Electric Company LF24T35 H9VT204063"
}
workspace "web" {}
workspace "work" {}
workspace "music" {}

//--------------------------------------------------------------------------------
// Environment & startup
//--------------------------------------------------------------------------------
environment {
    DISPLAY ":0"
    QT_QPA_PLATFORM "wayland;xcb"
    GDK_BACKEND "wayland"
    XCURSOR_THEME "Yaru"
    XCURSOR_SIZE "24"
    GTK_IM_MODULE "simple"
    GTK_THEME "Tokyonight-Dark-Compact"
    GTK_ICON_THEME "Yaru-blue-dark"
}

// Note: running niri as a session also supports xdg-desktop-autostart.
spawn-at-startup "noctalia"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "clipman" "store" "--no-persist"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "clipman" "store" "--no-persist"
spawn-at-startup "xwayland-satellite"

// Ask clients to omit client-side decorations when possible.
// Also fixes border/focus ring drawing behind semitransparent windows.
// After toggling this, restart apps for it to take effect.
prefer-no-csd

// Screenshots (path is formatted with strftime(3)).
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

//--------------------------------------------------------------------------------
// Layout
//--------------------------------------------------------------------------------
layout {
    gaps 5
    background-color "transparent"

    // "never" | "always" | "on-overflow"
    center-focused-column "never"

    // Widths toggled by switch-preset-column-width (Mod+R).
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // Initial width of new windows.
    default-column-width { proportion 0.5; }

    focus-ring {
        off
        width 2
        active-color "#7aa2f7"
        inactive-color "#1a1b26"
    }

    border {
        on
        width 2
        active-color "#7aa2f7"
        inactive-color "#1a1b26"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    tab-indicator {
        width 6
        gap 1
        position "left"
        corner-radius 2
        length total-proportion=0.8
    }
}

//--------------------------------------------------------------------------------
// Animations
//--------------------------------------------------------------------------------
animations {
    // Slow down all animations by this factor. Values below 1 speed them up.
    slowdown 0.5
}

//--------------------------------------------------------------------------------
// Overview
//--------------------------------------------------------------------------------
overview {
    workspace-shadow {
        on
    }
}

//--------------------------------------------------------------------------------
// Window rules (defined later = higher priority)
//--------------------------------------------------------------------------------
// Firefox picture-in-picture (works for both host and Flatpak app-ids).
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Block password managers and Zoom from screen capture.
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id="KeePassXC"
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    match app-id="zoom"
    block-out-from "screen-capture"
    open-floating true
}

// Dialogs / utilities that should float.
window-rule {
    match app-id="brave-browser" title="^Brave$"
    match app-id="helium" title="^Helium$"
    match app-id="org.openrgb.OpenRGB"
    match app-id="evolution-alarm-notify"
    match app-id="org.gnome.Calculator"
    match app-id="org.pulseaudio.pavucontrol"
    match app-id="com.saivert.pwvucontrol"
    match app-id="blueman-manager"
    match app-id="system-config-printer"
    match app-id="xfce-polkit"
    open-floating true
}

// Zoom menus.
window-rule {
    match app-id="Zoom Workplace" title=".*menu.*"
    match app-id="zoom"
    open-floating true
    min-width 250
    max-width 1920
    max-height 1080
    default-floating-position x=0 y=0 relative-to="top"
    open-focused true
}

// DMS (quickshell) windows.
window-rule {
    match app-id=r#"org.quickshell$"#
    open-floating true
}

// Rounded corners for all windows.
window-rule {
    geometry-corner-radius 10 10 0 0
    clip-to-geometry true
    draw-border-with-background true
}

// Noctalia settings window.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Wine desktop.
window-rule {
    match title="^Wine Desktop"
    open-floating true
    default-column-width { fixed 1024; }
    default-window-height { fixed 768; }
}

//--------------------------------------------------------------------------------
// Binds
// "Mod" = Super on a TTY, Alt in a winit window. Find key names with `wev`.
//--------------------------------------------------------------------------------
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Programs.
    Mod+T hotkey-overlay-title="Open a Terminal: " { spawn "AppImages/wezterm.appimage"; }
    Mod+A hotkey-overlay-title="Run an Application: " { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S hotkey-overlay-title="Run an Application (/win): " { spawn-sh "noctalia msg panel-toggle launcher /win"; }
    Mod+B hotkey-overlay-title="Open web browser: " { spawn-sh "AppImages/helium.appimage"; }
    Mod+Escape hotkey-overlay-title="Lock the Screen" { spawn-sh "noctalia msg session lock"; }
    Ctrl+Alt+H hotkey-overlay-title="Show clipboard history" { spawn-sh "noctalia msg panel-toggle clipboard"; }

    // Notifications.
    Mod+M                     hotkey-overlay-title="Show notifications"        { spawn-sh "noctalia msg panel-open control-center notifications"; }
    Mod+Alt+M                 hotkey-overlay-title="Toggle Do Not Disturb"     { spawn-sh "noctalia msg notification-dnd-toggle"; }
    Mod+Shift+M               hotkey-overlay-title="Clear active notifications" { spawn-sh "noctalia msg notification-clear-active"; }
    Mod+Ctrl+Shift+M          hotkey-overlay-title="Wipe notification history"  { spawn-sh "noctalia msg notification-clear-history"; }

    // Media / volume / brightness (work while locked).
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }

    // Overview (also: top-left hot corner, four-finger swipe up).
    Mod+O repeat=false { toggle-overview; }

    Mod+Q { close-window; }

    // Window switcher (noctalia overlay, replaces niri's built-in recent-windows).
    // "hold": release the modifier to focus the selected window; a quick tap
    // jumps straight to the previous window. "current" scopes the list to the
    // current workspace (replacement for the built-in's app-id filter binds).
    Alt+Tab              repeat=false { spawn-sh "noctalia msg window-switcher hold"; }
    Alt+Shift+Tab        repeat=false { spawn-sh "noctalia msg window-switcher hold reverse"; }
    Mod+Tab              repeat=false { spawn-sh "noctalia msg window-switcher hold"; }
    Mod+Shift+Tab        repeat=false { spawn-sh "noctalia msg window-switcher hold reverse"; }
    Alt+dead_grave       repeat=false { spawn-sh "noctalia msg window-switcher hold current"; }
    Alt+Shift+dead_grave repeat=false { spawn-sh "noctalia msg window-switcher hold reverse current"; }
    Mod+dead_grave       repeat=false { spawn-sh "noctalia msg window-switcher hold current"; }
    Mod+Shift+dead_grave repeat=false { spawn-sh "noctalia msg window-switcher hold reverse current"; }

    // Focus / move columns and windows.
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // Monitors.
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // Workspaces.
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
    Mod+Shift+Alt+L     { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+H     { move-workspace-to-monitor-left; }

    // By index (niri is dynamic: indices past the count hit the bottommost empty workspace).
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Mouse wheel (cooldown rate-limits the bind).
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Shift+wheel scrolls horizontally in most apps; replicate that.
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Column/window manipulation.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Sizing.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Floating vs tiling.
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Tabbed column display mode.
    Mod+W { toggle-column-tabbed-display; }

    // Layout switching lives in the keyboard switcher script (see below).

    // Screenshots.
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Session.
    Mod+Shift+Q { spawn-sh "noctalia msg panel-toggle session"; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }

    // Keyboard layout switcher.
    Mod+Shift+Space repeat=false { spawn "niri_fuzzel_keyboard_switcher"; }
}

//--------------------------------------------------------------------------------
// Layer rules
//--------------------------------------------------------------------------------
// Keep the wallpaper stationary rather than moving with workspaces.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

//--------------------------------------------------------------------------------
// Events
//--------------------------------------------------------------------------------
switch-events {
    lid-close {
        spawn "noctalia" "msg" "session" "lock"
    }
}
