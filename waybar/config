{
  "layer": "top",
  "position": "top", // Waybar position (top|bottom|left|right)
  "width": 0, // Waybar width
  "height": 20,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "spacing": 1, // Gaps between modules (4px)
  // Choose the order of the modules
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/window",
    "niri/workspaces",
    "niri/window",
    "hyprland/workspaces",
    "hyprland/window",
  ],
  "modules-center": [
    "niri/language",
    "clock",
    "privacy"
  ],
  "modules-right": [
    "group/audio",
    "tray",
    "group/screen",
    "group/power"
  ],
  // Modules configuration
  "sway/workspaces": {
    "disable-click": false,
    "all-outputs": false,
    "format": "{name}: {icon}",
    "format-icons": {
      "1": "",
      "2": "󰖟",
      "3": "",
      "4": "",
      "urgent": "",
      // "active": "",
      "default": ""
    }
  },
  "sway/window": {
    "icon": true,
    "icon-size": 14
  },
  "hyprland/workspaces": {
    "disable-click": false,
    "all-outputs": false,
    "format": "{name}: {icon}",
    "format-icons": {
      "1": "",
      "2": "󰖟",
      "3": "",
      "4": "",
      "urgent": "",
      // "active": "",
      "default": ""
    }
  },
  "hyprland/window": {
    "icon": true,
    "icon-size": 14
  },
  "niri/workspaces": {
    "disable-click": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "terminal": "",
      "web": "󰖟",
      "work": "",
      "music": "",
      "urgent": "",
      // "active": "",
      "default": ""
    }
  },
  "niri/language": {
    "format": "{short}"
  },
  "niri/window": {
    "icon": true,
    "icon-size": 14
  },
  "tray": {
    "spacing": 8,
    "icon-size": 14
  },
  "clock": {
    "timezone": "America/Buenos_Aires",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M %Y-%m-%d}"
  },
  "privacy": {
    "icon-spacing": 10,
    "icon-size": 12,
    "expand": true,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 16
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 16
      }
    ]
  },
  "group/power": {
    "orientation": "inherit",
    "modules": [
      "power-profiles-daemon",
      "upower"
    ]
  },
  "upower": {
    "format": "{percentage} {time}",
    "icon-size": 14,
    "hide-if-empty": true,
    "tooltip": true,
    "tooltip-spacing": 20,
    "show-icon": true
  },
  "power-profiles-daemon": {
    "format": "{icon} ",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "group/audio": {
    "orientation": "inherit",
    "modules": [
      "mpris",
      "wireplumber#source",
      "wireplumber"
    ]
  },
  "mpris": {
    "format": "{player_icon} ({status}) {dynamic}",
    "dynamic-len": 20,
    "format-paused": "{status_icon} ({status}) {dynamic}",
    "internal": "1",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵"
    },
	"status-icons": {
		"paused": "⏸"
	  }
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "󰍬 {volume}% ",
    "format-muted": "󰍭 {volume}% ",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "scroll-step": 5
  },
  "wireplumber": {
    "format": "{icon} {volume}% ",
    "format-muted": "󰝟 {volume}% ",
    "format-icons": {
      "headphone": " ",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "flatpak run com.saivert.pwvucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "group/screen": {
    "orientation": "inherit",
    "modules": [
      "backlight",
      "idle_inhibitor"
    ]
  },
  "idle_inhibitor": {
    "start-activated": true,
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    }
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  }
}
